generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountRole {
  Admin
  Owner
  Manager
  Employee
  Intern
  Customer
}

enum BusinessSpecialization {
  NAILS
  BROWS_AND_LASHES
  MAKEUP
}

enum BusinessType {
  SOLO
  TEAM
}

enum BusinessOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BusinessSetupStep {
  BUSINESS_BASICS
  LOCATION
  WORKSTATIONS
  SERVICES
  ADDONS
  TEAM
  TEAM_SERVICES
  AVAILABILITY
  BOOKING_RULES
  PUBLIC_PROFILE
  SUMMARY
}

model User {
  id                              String                  @id @default(uuid())
  email                           String
  passwordHash                    String
  firstName                       String
  lastName                        String
  phone                           String?
  birthDate                       DateTime?
  role                            AccountRole             @default(Customer)
  emailVerifiedAt                 DateTime?
  termsAndPrivacyPolicyAcceptedAt DateTime?
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  businessId                      String
  business                        Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessMemberships             BusinessMembership[]
  businessTeamMembers             BusinessTeamMember[]
  emailVerificationCodes          EmailVerificationCode[]

  @@unique([businessId, email])
  @@index([businessId])
  @@index([role])
}

model EmailVerificationCode {
  id             String    @id @default(uuid())
  codeHash       String
  expiresAt      DateTime
  failedAttempts Int       @default(0)
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
}

model Business {
  id                         String                     @id @default(uuid())
  name                       String
  slug                       String                     @unique
  specialization             BusinessSpecialization?
  businessType               BusinessType?
  city                       String?
  postalCode                 String?
  street                     String?
  buildingNumber             String?
  apartmentNumber            String?
  parkingNote                String?
  locationNote               String?
  onboardingStatus           BusinessOnboardingStatus   @default(NOT_STARTED)
  onboardingCurrentStep      BusinessSetupStep?
  onboardingCompletedSteps   BusinessSetupStep[]        @default([])
  onboardingCompletedAt      DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  domains                    BusinessDomain[]
  memberships                BusinessMembership[]
  services                   BusinessService[]
  teamMembers                BusinessTeamMember[]
  users                      User[]
  workstations               BusinessWorkstation[]
}

model BusinessService {
  id              String                  @id @default(uuid())
  name            String
  specialization  BusinessSpecialization
  workstationType BusinessSpecialization?
  durationMinutes Int
  priceAmount     Int
  isActive        Boolean                 @default(true)
  description     String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  businessId      String
  business        Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessWorkstation {
  id         String                 @id @default(uuid())
  name       String
  type       BusinessSpecialization
  isActive   Boolean                @default(true)
  note       String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  businessId String
  business   Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessDomain {
  id         String   @id @default(uuid())
  hostname   String   @unique
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model BusinessMembership {
  id               String      @id @default(uuid())
  role             AccountRole
  providesServices Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  businessId       String
  userId           String
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

model BusinessTeamMember {
  id               String      @id @default(uuid())
  fullName         String
  email            String?
  role             AccountRole
  providesServices Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  businessId       String
  userId           String?
  business         Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitations      BusinessTeamInvitation[]

  @@unique([businessId, email])
  @@unique([businessId, userId])
  @@index([businessId])
  @@index([userId])
}

model BusinessTeamInvitation {
  id           String             @id @default(uuid())
  email        String
  tokenHash    String             @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  teamMemberId String
  teamMember   BusinessTeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@index([teamMemberId])
}
