{
  "name": "@beauty-booking/shared",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./account": {
      "types": "./dist/account/index.d.ts",
      "default": "./dist/account/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./businessSetup": {
      "types": "./dist/businessSetup/index.d.ts",
      "default": "./dist/businessSetup/index.js"
    },
    "./roles": {
      "types": "./dist/roles/index.d.ts",
      "default": "./dist/roles/index.js"
    },
    "./tenant": {
      "types": "./dist/tenant/index.d.ts",
      "default": "./dist/tenant/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
